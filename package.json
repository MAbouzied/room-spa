{
  "name": "room-spa-2",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "generate:redirects": "node --experimental-strip-types scripts/generate-legacy-redirects.mjs",
    "build": "npm run generate:redirects && astro build && node scripts/prune-worker-bundle.mjs",
    "preview": "astro preview",
    "preview:cf": "npm run build && wrangler dev --config dist/server/wrangler.json",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "prune:worker": "node scripts/prune-worker-bundle.mjs",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "test:redirects": "node --test --experimental-strip-types src/lib/legacy-redirects.test.ts",
    "verify:redirects": "node --experimental-strip-types scripts/verify-legacy-redirects.mjs",
    "astro": "astro",
    "studio:dev": "npm --prefix studio run dev",
    "studio:deploy": "npm --prefix studio run deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.7",
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@lexical/history": "^0.49.0",
    "@lexical/html": "^0.49.0",
    "@lexical/link": "^0.49.0",
    "@lexical/list": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/rich-text": "^0.49.0",
    "@lexical/selection": "^0.49.0",
    "@sanity/client": "^7.26.0",
    "@sanity/image-url": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.1.1",
    "astro-portabletext": "^0.13.0",
    "better-auth": "^1.6.26",
    "lexical": "^0.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.91",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "astro-icon": "^1.1.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.114.0"
  }
}
