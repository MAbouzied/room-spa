  .list-eyebrow{margin:0 0 5px;color:var(--color-gold);font-size:11px;font-weight:900;letter-spacing:.04em}.list-header h2{margin:0;color:var(--color-text-primary);font-size:22px;line-height:1.3}.list-description{margin:7px 0 0;color:var(--color-text-muted);font-size:13px;line-height:1.7}
  .list-total{display:grid;place-items:center;min-width:74px;padding:10px 14px;border:1px solid var(--color-border-card);border-radius:15px;background:var(--color-bg-card);color:var(--color-text-muted)}.list-total strong{color:var(--color-gold);font-size:25px;line-height:1;font-weight:900}.list-total span{margin-top:5px;font-size:11px;font-weight:700}
  .list-tools{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 22px;border-top:1px solid var(--color-border-card);border-bottom:1px solid var(--color-border-card);background:var(--color-bg-card)}.search{position:relative;display:block;flex:1;max-width:390px}.search-icon{position:absolute;inset-inline-start:12px;top:50%;z-index:1;color:var(--color-text-muted);font-size:21px;line-height:1;transform:translateY(-54%) rotate(-20deg);pointer-events:none}.search input{width:100%;min-width:0;padding:11px 37px 11px 14px;border:1px solid var(--color-border-input);border-radius:11px;background:var(--color-bg-card);color:var(--color-text-primary);font:inherit;font-size:13px}.search input:focus,.filter select:focus{border-color:var(--color-gold);box-shadow:0 0 0 3px color-mix(in srgb, var(--color-gold) 28%, transparent);outline:0}.filter{display:flex;align-items:center;gap:8px;color:var(--color-text-muted);font-size:12px;font-weight:700;white-space:nowrap}.filter select{min-width:135px;width:auto;border:1px solid var(--color-border-input);border-radius:11px;background:var(--color-bg-card);color:var(--color-text-primary);padding:10px 32px 10px 11px;font:inherit;font-size:13px;cursor:pointer}.filter select option{background:var(--color-bg-card);color:var(--color-text-primary)}
  .post-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;padding:22px;background:var(--color-bg-secondary)}.blog-admin-card{display:flex;min-width:0;flex-direction:column;overflow:hidden;border-radius:16px;background:var(--color-bg-card);box-shadow:0 8px 24px -14px rgb(0 0 0 / 35%);transition:box-shadow .2s ease,transform .2s ease}.blog-admin-card:hover{box-shadow:0 18px 38px -18px rgb(0 0 0 / 45%);transform:translateY(-2px)}.blog-card-media{position:relative;overflow:hidden;aspect-ratio:16/10;background:var(--color-bg-form)}.blog-card-media img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .25s cubic-bezier(.22,1,.36,1)}.blog-admin-card:hover .blog-card-media img{transform:scale(1.025)}.blog-card-placeholder{display:grid;width:100%;height:100%;place-items:center;background:var(--color-bg-tertiary);color:var(--color-text-muted);font-size:24px;font-weight:900}.blog-card-flags{position:absolute;inset:12px 12px auto;display:flex;align-items:center;justify-content:space-between;gap:8px;pointer-events:none}.blog-card-status,.blog-card-featured{display:inline-flex;min-height:28px;align-items:center;gap:6px;padding:5px 9px;border-radius:999px;background:var(--color-bg-card);color:var(--color-success);box-shadow:0 4px 14px rgb(0 0 0 / 35%);font-size:11px;font-weight:800}.blog-card-status::before{width:6px;height:6px;border-radius:50%;background:var(--color-success);content:""}.blog-card-status.is-draft{color:var(--color-gold)}.blog-card-status.is-draft::before{background:var(--color-gold)}.blog-card-featured{margin-inline-start:auto;color:var(--color-gold-light)}.blog-card-body{display:flex;flex:1;flex-direction:column;padding:18px 18px 16px}.blog-card-date{margin:0 0 8px;color:var(--color-text-muted);font-size:11px;font-weight:700}.blog-card-title{display:-webkit-box;overflow:hidden;margin:0;color:var(--color-text-primary);font-size:16px;font-weight:900;line-height:1.65;-webkit-box-orient:vertical;-webkit-line-clamp:2}.blog-card-excerpt{display:-webkit-box;overflow:hidden;margin:9px 0 0;color:var(--color-text-muted);font-size:12px;line-height:1.75;-webkit-box-orient:vertical;-webkit-line-clamp:2}.blog-card-author{margin:auto 0 0;padding-top:14px;color:var(--color-text-muted);font-size:11px}.blog-card-actions{margin-top:auto;padding:0 16px 15px}.blog-card-actions-main{display:grid;grid-template-columns:1.15fr .85fr;gap:8px}.blog-card-actions button{min-height:38px;border-radius:10px;font:inherit;font-size:12px;font-weight:800;cursor:pointer}.blog-card-edit{border:1px solid var(--color-gold);background:var(--color-gold);color:var(--color-text-btn)}.blog-card-edit:hover{background:var(--color-gold-light)}.blog-card-preview{border:1px solid var(--color-border-badge);background:var(--color-bg-form);color:var(--color-gold)}.blog-card-actions-sub{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:9px;padding-top:9px;border-top:1px solid var(--color-border-card)}.blog-card-actions-sub button{min-height:30px;border:0;border-radius:7px;background:transparent;padding:4px 6px;color:var(--color-text-nav);font-size:11px}.blog-card-actions-sub .blog-card-publish{color:var(--color-success)}.blog-card-actions-sub .blog-card-unpublish{color:var(--color-gold)}.blog-card-actions-sub .blog-card-delete{margin-inline-start:auto;color:var(--color-danger)}.blog-card-actions button:hover{filter:brightness(.96)}
