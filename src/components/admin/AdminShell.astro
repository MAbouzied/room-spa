  .button-preview{width:100%;background:var(--color-bg-form);border:1px solid var(--color-border-badge);color:var(--color-gold)}
  .button:focus-visible,.nav-button:focus-visible,.new-post-button:focus-visible,.admin-logout-button:focus-visible,.text-button:focus-visible{outline:3px solid color-mix(in srgb, var(--color-gold) 45%, transparent);outline-offset:2px}
  .text-button{background:none;border:0;color:var(--color-gold);font:inherit;font-weight:800;cursor:pointer;text-decoration:none}
  .admin-status{margin:18px 0;padding:12px 15px;border-radius:10px;background:color-mix(in srgb, var(--color-success) 22%, var(--color-bg-card));color:var(--color-success)}
  .admin-status.error{background:color-mix(in srgb, var(--color-danger) 18%, var(--color-bg-card));color:var(--color-danger)}
  .stats-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:26px 0}
  .stat-card,.list-card,.side-card{background:var(--color-bg-card);border:1px solid var(--color-border-card);border-radius:16px;box-shadow:0 8px 26px rgb(0 0 0 / 28%);color:var(--color-text-primary)}
  .stat-card{padding:18px 20px}.stat-card span{display:block;color:var(--color-text-muted);font-size:13px}.stat-card strong{display:block;font-size:30px;margin-top:6px;color:var(--color-text-primary)}
