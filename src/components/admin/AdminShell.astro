  @media(max-width:900px){.admin-shell{display:block}.admin-sidebar{position:relative;top:auto;width:auto;height:auto;min-height:0;overflow:visible;flex-direction:row;flex-wrap:wrap;align-items:center;padding:16px;gap:12px}.admin-sidebar nav{display:flex;flex:1;min-width:0}.admin-sidebar-actions{margin:0;display:flex;align-items:center;gap:8px;margin-inline-start:auto}.admin-logout-button,.new-post-button{white-space:nowrap;padding-inline:12px}.admin-main{min-height:0;padding:22px 15px 50px}.editor-grid{grid-template-columns:1fr}.editor-side{grid-row:1}.admin-header{display:block}.admin-actions{margin-top:18px}.stats-grid{gap:8px}.stat-card{padding:13px}.stat-card strong{font-size:24px}.post-list{gap:15px;padding:17px}.post-list{grid-template-columns:repeat(2,minmax(0,1fr))}.list-header{padding:21px 18px}.list-tools{align-items:stretch;padding:12px 16px}.search{max-width:none}.post-title{white-space:normal}.blog-card-body{padding-inline:15px}.blog-card-actions{padding-inline:13px}.blog-card-actions button{font-size:11px}}
  @media(max-width:560px){.admin-header h1{font-size:29px}.admin-sidebar-actions{width:100%;margin-inline-start:0}.admin-sidebar-actions .new-post-button,.admin-sidebar-actions .admin-logout-button{flex:1}.stats-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.list-header{align-items:flex-start}.list-total{min-width:62px;padding:8px 10px}.list-header h2{font-size:19px}.list-description{font-size:12px}.list-tools{display:grid;grid-template-columns:1fr}.filter{justify-content:space-between}.filter select{flex:1}.post-list{grid-template-columns:1fr;padding:12px}.blog-card-media{aspect-ratio:16/9}.blog-card-actions button{font-size:12px}.preview-bar{gap:10px;flex-wrap:wrap}.preview-bar .button{margin-inline-start:auto}}
  .content-editor blockquote{border-right:0;box-shadow:inset -3px 0 var(--color-gold)}.preview-article blockquote{border-right:0;box-shadow:inset -4px 0 var(--color-gold)}.lexical-content,.lexical-content p,.lexical-content h2,.lexical-content h3,.lexical-content li,.lexical-content blockquote{direction:rtl!important;text-align:right!important;unicode-bidi:plaintext}.content-field{overflow:visible}.content-field .rich-toolbar{position:sticky;top:0;z-index:10;box-shadow:0 3px 12px rgb(0 0 0 / 25%)}.rich-toolbar button[aria-pressed="true"]{background:var(--color-gold);color:var(--color-text-btn);box-shadow:0 2px 8px color-mix(in srgb, var(--color-gold) 35%, transparent)}.rich-toolbar button[aria-pressed="true"]:hover{background:var(--color-gold-light);color:var(--color-text-btn)}.rich-toolbar button:focus-visible{outline:2px solid var(--color-gold);outline-offset:2px}
