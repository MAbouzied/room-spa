:none}.content-editor:empty:before{content:attr(data-placeholder);color:var(--color-text-muted)}.content-editor img{max-width:100%;height:auto}.content-editor blockquote{margin:16px 0;padding:8px 16px;background:var(--color-bg-tertiary);box-shadow:inset -3px 0 var(--color-gold)}.content-editor h2{margin:2rem 0 .35rem;font-size:1.55rem;line-height:1.35;font-weight:800}.content-editor h3{margin:1.5rem 0 .25rem;font-size:1.3rem;line-height:1.4;font-weight:800}.content-editor ul,.content-editor ol{display:block;padding-inline-start:1.5rem;margin:0 0 .85rem}.content-editor a{color:var(--color-gold);text-decoration:underline}.editor-inline-image,.editor-inline-video{margin:1rem 0;padding:0}.editor-inline-image img{display:block;max-width:100%;height:auto;border-radius:12px}.editor-inline-image figcaption{margin-top:.45rem;color:var(--color-text-muted);font-size:.85rem;text-align:center}.editor-inline-video,.editor-video-frame{display:block;width:100%;max-width:100%}.editor-inline-video iframe{display:block;width:100%;height:auto;aspect-ratio:16/9;min-height:0;border:0;border-radius:12px}.action-spinner{display:inline-block;width:14px;height:14px;margin-inline-end:6px;border:2px solid currentColor;border-left-color:transparent;border-radius:50%;animation:admin-spin .7s linear infinite}@keyframes admin-spin{to{transform:rotate(360deg)}}button:disabled{cursor:not-allowed;opacity:.7}.editor-modal-backdrop{position:fixed;inset:0;z-index:20;display:grid;place-items:center;padding:20px;background:rgb(0 0 0 / 55%)}.editor-modal{width:min(100%,480px);display:grid;gap:15px;padding:22px;border:1px solid var(--color-border-card);border-radius:18px;background:var(--color-bg-card);box-shadow:0 20px 70px rgb(0 0 0 / 45%);color:var(--color-text-primary)}.editor-modal h2{margin:0;color:var(--color-text-primary);font-size:19px}.editor-modal label{display:grid;gap:7px;color:var(--color-text-nav);font-weight:800;font-size:13px}.editor-modal input:not([type=file]),.editor-modal textarea,.edit