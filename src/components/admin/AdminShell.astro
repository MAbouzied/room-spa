---
import AdminLayout from '../../layouts/AdminLayout.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  subtitle: string;
  active?: 'overview' | 'editor' | 'preview' | 'users';
  headerActionHref?: string;
  headerActionLabel?: string;
}

const {
  title,
  description,
  heading,
  subtitle,
  active = 'overview',
  headerActionHref = '/admin/create',
  headerActionLabel = 'مقال جديد',
} = Astro.props;
---

<AdminLayout title={title} description={description} locale="ar">
  <main class="admin-shell" dir="rtl">
    <aside class="admin-sidebar">
      <a href="/" class="admin-brand">روم سبا <span>المدونة</span></a>
      <nav aria-label="التنقل الإداري">
        <a class:list={['nav-button', { 'is-active': active === 'overview' || active === 'editor' || active === 'preview' }]} href="/admin">المقالات</a>
        <a class:list={['nav-button', { 'is-active': active === 'users' }]} href="/admin/users">المستخدمون</a>
        <a class="nav-button" href="/blogs/">عرض المدونة</a>
      </nav>
      <div class="admin-sidebar-actions">
        <a class="new-post-button" href="/admin/create">+ مقال جديد</a>
        <button type="button" id="admin-logout" class="admin-logout-button">تسجيل الخروج</button>
      </div>
    </aside>

    <section class="admin-main">
      <header class="admin-header">
        <div>
          <p class="admin-kicker">لوحة التحرير</p>
          <h1>{heading}</h1>
          <p class="admin-subtitle">{subtitle}</p>
        </div>
        <div class="admin-actions">
          <a class="button button-primary" href={headerActionHref}>{headerActionLabel}</a>
        </div>
      </header>
      <div id="admin-status" class="admin-status" role="status" hidden></div>
      <slot />
    </section>
  </main>
</AdminLayout>

<script>
  import {
    ADMIN_LOGOUT_ERROR_MESSAGE,
    performAdminSignOut,
  } from '../../lib/auth/admin-logout';
  import { authClient } from '../../lib/auth/client';

  const logout = document.getElementById('admin-logout');
  logout?.addEventListener('click', async () => {
    if (!(logout instanceof HTMLButtonElement)) return;

    logout.disabled = true;
    try {
      await performAdminSignOut(authClient, (url) => {
        window.location.assign(url);
      });
    } catch {
      logout.disabled = false;
      const status = document.getElementById('admin-status');
      if (status) {
        status.hidden = false;
        status.classList.add('error');
        status.textContent = ADMIN_LOGOUT_ERROR_MESSAGE;
      }
    }
  });
</script>

<style is:global>

