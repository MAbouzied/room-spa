  .admin-sidebar{position:sticky;top:0;align-self:flex-start;width:248px;height:100dvh;min-height:100dvh;overflow-y:auto;background:var(--color-bg-hero);color:var(--color-text-primary);padding:28px 18px;display:flex;flex-direction:column;gap:32px}
  .admin-brand{font-size:19px;font-weight:900;color:var(--color-text-primary);text-decoration:none;padding:0 10px}
  .admin-brand span{display:block;color:var(--color-gold-light);font-size:12px;margin-top:4px}
  .admin-sidebar nav{display:grid;gap:6px}
  .nav-button{border:0;background:transparent;color:var(--color-text-nav);text-decoration:none;text-align:right;padding:12px 14px;border-radius:12px;font:inherit;font-size:14px;cursor:pointer}
  .nav-button:hover{background:var(--color-bg-tertiary);color:var(--color-text-primary)}
  .nav-button.is-active{background:var(--color-bg-form);color:var(--color-gold);font-weight:800}
  .admin-sidebar-actions{display:grid;gap:8px;margin-top:auto}
