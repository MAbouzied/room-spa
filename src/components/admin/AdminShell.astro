  .new-post-button:hover{background:var(--color-gold-light)}
  .admin-logout-button{border:1px solid var(--color-border-card);background:var(--color-bg-tertiary);color:var(--color-text-primary);text-align:center;border-radius:12px;padding:12px;font:inherit;font-size:14px;font-weight:800;cursor:pointer}
  .admin-logout-button:hover{background:var(--color-bg-form);color:var(--color-text-primary)}
  .admin-main{flex:1;min-width:0;min-height:100dvh;padding:32px clamp(18px,4vw,56px) 70px;background:var(--color-bg-primary);color:var(--color-text-primary)}
  .admin-header{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;border-bottom:1px solid var(--color-border-card);padding-bottom:25px}
  .admin-kicker{color:var(--color-gold);font-size:12px;font-weight:900;margin:0 0 8px}
