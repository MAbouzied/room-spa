---
import { galleryImages } from '../data/gallery';
import SectionHeading from './SectionHeading.astro';

const featured = galleryImages.find((image) => image.featured) ?? galleryImages[0];
const tiles = galleryImages.filter((image) => image !== featured);
---

<section class="section gallery" id="photos">
  <div class="container">
    <SectionHeading
      eyebrow="صورنا"
      title="لمحة من روم سبا"
      highlight="روم سبا"
      lead="أجواء راقية وتفاصيل مدروسة لتجربة لا تُنسى"
    />
    <div class="gallery__grid reveal">
      {
        featured && (
          <figure class="gallery__item gallery__item--featured">
            <img
              src={featured.src}
              alt={featured.alt}
              width="1600"
              height="900"
              decoding="async"
            />
          </figure>
        )
      }
      {
        tiles.map((image) => (
          <figure class="gallery__item">
            <img
              src={image.src}
              alt={image.alt}
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery__grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
  }

  .gallery__item {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-soft);
    background: var(--color-bg-deep);
    aspect-ratio: 4 / 3;
  }

  .gallery__item--featured {
    aspect-ratio: 16 / 10;
  }

  .gallery__item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media (min-width: 700px) {
    .gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .gallery__item--featured {
      grid-column: 1 / -1;
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 1100px) {
    .gallery__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
