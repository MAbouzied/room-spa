---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';
import { GTM_EVENTS, gtmContactAttrs } from '../lib/gtm';
---

<a
  class="wa-float"
  href={site.whatsappBookUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="واتساب"
  {...gtmContactAttrs(GTM_EVENTS.whatsapp, 'floating')}
>
  <Icon name="mdi:whatsapp" class="icon icon--xl" aria-hidden="true" />
</a>

<style>
  .wa-float {
    position: fixed;
    inset-inline-end: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--color-whatsapp);
    color: #fff;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
    transition: transform 0.2s var(--ease-out), background 0.2s;
  }

  .wa-float:hover {
    transform: scale(1.06);
    background: var(--color-whatsapp-dark);
  }
</style>
