---
import { Icon } from 'astro-icon/components';
import Button from './Button.astro';
import { site } from '../data/site';
import { formCopy, type FormLocale } from '../lib/form-copy';

interface Props {
  locale?: FormLocale;
}

const { locale = 'ar' } = Astro.props;
const copy = formCopy[locale];
---

<div class="contact-form-card">
  <Button href={site.whatsappBookUrl} variant="accent" shape="xl" external full>
    <Icon name="mdi:whatsapp" class="icon icon--md" aria-hidden="true" />
    {copy.submit}
  </Button>
</div>

<style>
  .contact-form-card {
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-card);
    background: var(--color-bg-card);
  }

  @media (min-width: 640px) {
    .contact-form-card {
      padding: 1.5rem;
    }
  }
</style>
