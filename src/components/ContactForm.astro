---
import { Icon } from 'astro-icon/components';
import Button from './Button.astro';
import { site } from '../data/site';
import { formCopy, type FormLocale } from '../lib/form-copy';
import { GTM_EVENTS, gtmContactAttrs } from '../lib/gtm';

interface Props {
  locale?: FormLocale;
}

const { locale = 'ar' } = Astro.props;
const copy = formCopy[locale];
---

<Button href={site.whatsappBookUrl} variant="whatsapp" shape="xl" external full {...gtmContactAttrs(GTM_EVENTS.whatsapp, 'form_landing')}>
  <Icon name="mdi:whatsapp" class="icon icon--md" aria-hidden="true" />
  {copy.whatsappAction}
</Button>
