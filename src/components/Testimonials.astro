---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';
import type { Testimonial } from '../data/testimonials';
import SectionHeading from './SectionHeading.astro';

interface Props {
  items: Testimonial[];
  eyebrow?: string;
  title?: string;
  highlight?: string;
  showGoogleRating?: boolean;
}

const {
  items,
  eyebrow = 'آراء العملاء',
  title = 'ماذا يقول عملاؤنا',
  highlight = 'عملاؤنا',
  showGoogleRating = true,
} = Astro.props;

const ratingLabel = `${site.google.ratingValue} من 5`;
const reviewCountLabel = `${site.google.reviewCount} تقييم على Google`;
---

<section class="section section--gradient testimonials" id="testimonials">
  <div class="container">
    <SectionHeading eyebrow={eyebrow} title={title} highlight={highlight} />
    {
      showGoogleRating && (
        <a
          class="testimonials__google reveal"
          href={site.google.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="testimonials__google-score" aria-label={`تقييم Google ${ratingLabel}`}>
            <Icon name="mdi:star" class="testimonials__google-star" aria-hidden="true" />
            <strong>{site.google.ratingValue}</strong>
          </span>
          <span class="testimonials__google-meta">{reviewCountLabel}</span>
          <span class="testimonials__google-link">عرض على الخريطة</span>
        </a>
      )
    }
    <div class="testimonials__grid">
      {
        items.map((item) => (
          <article class="testimonials__card reveal">
            <Icon name="mdi:format-quote-open" class="testimonials__mark" aria-hidden="true" />
            <p class="testimonials__quote">{item.quote}</p>
            <div class="testimonials__author">
              <p class="testimonials__name">{item.name}</p>
              {item.meta && (
                <p class="testimonials__meta">
                  <span>{item.meta}</span>
                  <span class="testimonials__stars" aria-label="تقييم 5 من 5">
                    {Array.from({ length: 5 }).map(() => (
                      <Icon name="mdi:star" class="testimonials__star" aria-hidden="true" />
                    ))}
                  </span>
                </p>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .testimonials__google {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.65rem 1rem;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 1.75rem;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-pill);
    background: rgba(0, 0, 0, 0.16);
    color: var(--color-text);
    text-decoration: none;
    transition:
      background 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out),
      transform 0.2s var(--ease-out);
  }

  .testimonials__google:hover {
    background: rgba(156, 143, 124, 0.12);
    border-color: rgba(156, 143, 124, 0.45);
    transform: translateY(-1px);
  }

  .testimonials__google-score {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--color-accent);
    font-size: 1.05rem;
  }

  .testimonials__google-star {
    width: 1.15rem;
    height: 1.15rem;
  }

  .testimonials__google-meta {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .testimonials__google-link {
    color: var(--color-accent-soft);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .testimonials__grid {
    display: grid;
    gap: 1rem;
    max-width: 64rem;
    margin-inline: auto;
    align-items: stretch;
  }

  .testimonials__card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 0.85rem;
    padding: 1.25rem;
    border-radius: 1rem;
    border: 1px solid var(--color-border-soft);
    background:
      linear-gradient(160deg, rgba(156, 143, 124, 0.08), transparent 42%),
      rgba(0, 0, 0, 0.16);
    overflow: hidden;
  }

  .testimonials__mark {
    position: absolute;
    top: 1rem;
    left: 1rem;
    width: 1.5rem;
    height: 1.5rem;
    color: rgba(156, 143, 124, 0.22);
    pointer-events: none;
  }

  .testimonials__stars {
    display: inline-flex;
    gap: 0.08rem;
    color: var(--color-accent);
    vertical-align: middle;
  }

  .testimonials__star {
    width: 0.85rem;
    height: 0.85rem;
  }

  .testimonials__quote {
    color: var(--color-text);
    font-size: 0.9rem;
    line-height: 1.8;
    flex: 1;
  }

  .testimonials__author {
    margin-top: auto;
  }

  .testimonials__name {
    font-weight: 700;
    font-size: 0.875rem;
  }

  .testimonials__meta {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 500;
    margin-top: 0.25rem;
  }

  @media (min-width: 768px) {
    .testimonials__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .testimonials__card {
      padding: 2rem;
      border-radius: 1.15rem;
    }

    .testimonials__mark {
      top: 1.5rem;
      left: 1.5rem;
      width: 2rem;
      height: 2rem;
    }

    .testimonials__star {
      width: 0.95rem;
      height: 0.95rem;
    }

    .testimonials__quote {
      font-size: 1rem;
    }
  }
</style>
