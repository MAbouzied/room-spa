---
import { Icon } from 'astro-icon/components';
import type { Testimonial } from '../data/testimonials';
import SectionHeading from './SectionHeading.astro';

interface Props {
  items: Testimonial[];
  eyebrow?: string;
  title?: string;
  highlight?: string;
}

const {
  items,
  eyebrow = 'آراء العملاء',
  title = 'ماذا يقول عملاؤنا',
  highlight = 'عملاؤنا',
} = Astro.props;
---

<section class="section section--gradient testimonials" id="testimonials">
  <div class="container">
    <SectionHeading eyebrow={eyebrow} title={title} highlight={highlight} />
    <div class="testimonials__grid">
      {
        items.map((item) => (
          <article class="testimonials__card reveal">
            <Icon name="mdi:format-quote-open" class="testimonials__mark" aria-hidden="true" />
            <div class="testimonials__stars" aria-label="تقييم 5 من 5">
              {Array.from({ length: 5 }).map(() => (
                <Icon name="mdi:star" class="testimonials__star" aria-hidden="true" />
              ))}
            </div>
            <p class="testimonials__quote">{item.quote}</p>
            <div class="testimonials__author">
              <p class="testimonials__name">{item.name}</p>
              {item.meta && <p class="testimonials__meta">{item.meta}</p>}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .testimonials__grid {
    display: grid;
    gap: 1rem;
    max-width: 64rem;
    margin-inline: auto;
    align-items: stretch;
  }

  .testimonials__card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 0.85rem;
    padding: 1.25rem;
    border-radius: 1rem;
    border: 1px solid var(--color-border-soft);
    background:
      linear-gradient(160deg, rgba(156, 143, 124, 0.08), transparent 42%),
      rgba(0, 0, 0, 0.16);
    overflow: hidden;
  }

  .testimonials__mark {
    position: absolute;
    top: 1rem;
    left: 1rem;
    width: 1.5rem;
    height: 1.5rem;
    color: rgba(156, 143, 124, 0.22);
    pointer-events: none;
  }

  .testimonials__stars {
    display: flex;
    gap: 0.12rem;
    color: var(--color-accent);
  }

  .testimonials__star {
    width: 0.9rem;
    height: 0.9rem;
  }

  .testimonials__quote {
    color: var(--color-text);
    font-size: 0.9rem;
    line-height: 1.8;
    flex: 1;
  }

  .testimonials__author {
    margin-top: auto;
  }

  .testimonials__name {
    font-weight: 700;
    font-size: 0.875rem;
  }

  .testimonials__meta {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 500;
    margin-top: 0.15rem;
  }

  @media (min-width: 768px) {
    .testimonials__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .testimonials__card {
      padding: 2rem;
      border-radius: 1.15rem;
    }

    .testimonials__mark {
      top: 1.5rem;
      left: 1.5rem;
      width: 2rem;
      height: 2rem;
    }

    .testimonials__star {
      width: 1rem;
      height: 1rem;
    }

    .testimonials__quote {
      font-size: 1rem;
    }
  }
</style>
