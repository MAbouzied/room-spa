---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <img
        class="site-footer__logo"
        src="/images/logo-full.png"
        alt={site.nameAr}
        width="849"
        height="853"
        loading="lazy"
      />
      <h3>{site.nameAr} {site.tagline}</h3>
      <p>{site.description}</p>
    </div>

    <div class="site-footer__cols">
      <div class="site-footer__col">
        <h4>موقعنا</h4>
        <ul>
          {
            site.branches.map((branch) => (
              <li>
                <a href={branch.mapsUrl} target="_blank" rel="noopener noreferrer">
                  <Icon name="mdi:map-marker" class="icon icon--sm site-footer__pin" aria-hidden="true" />
                  {branch.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="site-footer__col">
        <h4>روابط سريعة</h4>
        <ul>
          <li>
            <a href="/blogs/">المدونة</a>
          </li>
          <li>
            <a href="/gift">الإهداءات</a>
          </li>
          <li>
            <a href="/#services">خدماتنا</a>
          </li>
        </ul>
      </div>

      <div class="site-footer__col">
        <h4>تواصل معنا</h4>
        <div class="site-footer__contact">
          <a href={`tel:${site.phoneTel}`}>
            <Icon name="mdi:phone-outline" class="icon icon--sm" aria-hidden="true" />
            <span class="phone" dir="ltr">{site.phoneDisplay}</span>
          </a>
          <a href={site.whatsappBookUrl} target="_blank" rel="noopener noreferrer">
            <Icon name="mdi:message-outline" class="icon icon--sm" aria-hidden="true" />
            واتساب
          </a>
        </div>
      </div>
    </div>

    <div class="site-footer__follow">
      <h4>تابعنا</h4>
      <div class="site-footer__social">
        <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <Icon name="mdi:instagram" class="icon icon--md" aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="site-footer__vat">
      <a
        class="site-footer__vat-trigger"
        href={site.vat.certificateUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`عرض شهادة تسجيل ضريبة القيمة المضافة — الرقم الضريبي ${site.vat.registrationNumber}`}
      >
        <img
          class="site-footer__vat-badge"
          src={site.vat.badgeUrl}
          alt={site.vat.authorityNameAr}
          width="313"
          height="75"
          loading="lazy"
        />
        <span class="site-footer__vat-text">
          <span class="site-footer__vat-label">الرقم الضريبي</span>
          <span class="site-footer__vat-number" dir="ltr">{site.vat.registrationNumber}</span>
        </span>
      </a>
    </div>

    <p class="site-footer__copy">
      جميع الحقوق محفوظة © {year} {site.nameEn} - {site.nameAr}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3rem, 6vw, 4rem) 1.75rem;
    border-top: 1px solid var(--color-border-soft);
    background: transparent;
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .site-footer__brand {
    text-align: center;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .site-footer__logo {
    display: block;
    height: 5.5rem;
    width: auto;
    margin: 0 auto 1.25rem;
    object-fit: contain;
  }

  @media (min-width: 768px) {
    .site-footer__logo {
      height: 6.5rem;
    }
  }

  .site-footer__brand h3 {
    font-size: clamp(1rem, 2vw, 1.125rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 0.75rem;
  }

  .site-footer__brand p {
    color: var(--color-text-muted);
    font-size: clamp(0.8125rem, 1.5vw, 0.875rem);
    line-height: 1.8;
    max-width: 32rem;
    margin-inline: auto;
  }

  .site-footer h4 {
    font-size: clamp(0.875rem, 1.5vw, 1rem);
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .site-footer__cols {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    width: 100%;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .site-footer__col {
    text-align: center;
  }

  .site-footer__col ul,
  .site-footer__contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .site-footer__col a,
  .site-footer__contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-size: clamp(0.75rem, 1.4vw, 0.875rem);
    transition: color 0.2s;
  }

  .site-footer__col a:hover,
  .site-footer__contact a:hover {
    color: var(--color-accent);
  }

  .site-footer__pin {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .site-footer__follow {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .site-footer__social {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .site-footer__social a {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--color-accent);
    background: rgba(156, 143, 124, 0.1);
    transition: background 0.2s;
  }

  .site-footer__social a:hover {
    background: rgba(156, 143, 124, 0.2);
  }

  .site-footer__vat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    margin-bottom: 1.5rem;
  }

  .site-footer__vat-trigger {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    max-width: min(20rem, 100%);
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    cursor: pointer;
    transition:
      background 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out);
  }

  .site-footer__vat-trigger:hover,
  .site-footer__vat-trigger:focus-visible {
    background: var(--color-surface-hover);
    border-color: var(--color-accent);
    outline: none;
  }

  .site-footer__vat-badge {
    width: min(16rem, 100%);
    height: auto;
    aspect-ratio: 626 / 150;
    object-fit: contain;
  }

  .site-footer__vat-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    text-align: center;
  }

  .site-footer__vat-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .site-footer__vat-number {
    font-size: clamp(0.8125rem, 1.4vw, 0.875rem);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .site-footer__copy {
    width: 100%;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-soft);
    text-align: center;
    color: var(--color-text-muted);
    font-size: clamp(0.6875rem, 1.2vw, 0.75rem);
  }

  @media (min-width: 768px) {
    .site-footer__cols {
      flex-direction: row;
      gap: 4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__vat-trigger {
      transition: none;
    }
  }
</style>
