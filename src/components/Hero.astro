---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';
import Button from './Button.astro';

interface Props {
  variant?: 'home' | 'gift';
}

const { variant = 'home' } = Astro.props;
const isGift = variant === 'gift';
---

<section class:list={['hero', isGift && 'hero--gift']} id="hero">
  {
    !isGift && (
      <>
        <div class="hero__media" aria-hidden="true">
          <img
            class="hero__image"
            src="/images/hero-poster.webp"
            alt=""
            width="720"
            height="1280"
            decoding="async"
            fetchpriority="high"
          />
          <video
            class="hero__video"
            muted
            autoplay
            loop
            playsinline
            webkit-playsinline
            preload="metadata"
            poster="/images/hero-poster.webp"
            data-hero-video
          >
            <source data-src="/videos/room-spa-hero.mp4" type="video/mp4" />
            <source data-src="/videos/room-spa-hero.webm" type="video/webm" />
          </video>
        </div>
        <div class="hero__overlay" aria-hidden="true" />
      </>
    )
  }
  <div class="hero__content container">
    {
      isGift ? (
        <>
          <p class="hero__badge">
            <Icon name="mdi:gift-outline" class="icon icon--md" aria-hidden="true" />
            إهداءات روم سبا
          </p>
          <h1>
            أهديه <span class="text-gradient-gold">لحظة</span>
            <br />
            <span class="text-gradient-gold">هدوء</span> حقيقية
          </h1>
          <p class="hero__lead">
            أنتِ تختارين الباقة، ونحن نتولّى استقباله وضيافته وخدمته بأرقى صورة تليق به
          </p>
          <div class="hero__actions">
            <Button href={site.whatsappGiftUrl} variant="accent" shape="xl" external>
              <Icon name="mdi:gift-outline" class="icon icon--md" aria-hidden="true" />
              أهديه الآن
            </Button>
            <Button href="#packages" variant="outline" shape="xl">تصفّحي الباقات</Button>
          </div>
        </>
      ) : (
        <>
          <h1>
            <span class="text-gradient-gold">الفخامة..</span> تزهى بك
          </h1>
          <p class="hero__lead">
            الوجهة الرجالية الأولى للمساج والحمام المغربي في حفر الباطن، حيث تبدأ تجربة مختلفة تليق بذوقك.
          </p>
          <div class="hero__actions">
            <Button href={site.whatsappBookUrl} variant="whatsapp-dark" shape="xl" external>
              <Icon name="mdi:whatsapp" class="icon icon--md" aria-hidden="true" />
              احجز عبر الواتساب
            </Button>
            <Button href={`tel:${site.phoneTel}`} variant="accent" shape="xl">
              <Icon name="mdi:phone" class="icon icon--md" aria-hidden="true" />
              <span class="phone" dir="ltr">{site.phoneDisplay}</span>
            </Button>
          </div>
        </>
      )
    }
  </div>
</section>

<script>
  type NetworkInformation = {
    saveData?: boolean;
  };

  type PendingHeroLoad = {
    id: number;
    kind: 'idle' | 'timeout';
  };

  let pendingHeroLoad: PendingHeroLoad | null = null;
  let resumeHeroPlayback: (() => void) | null = null;

  const cancelPendingHeroLoad = () => {
    if (!pendingHeroLoad) return;

    if (pendingHeroLoad.kind === 'idle') {
      window.cancelIdleCallback(pendingHeroLoad.id);
    } else {
      window.clearTimeout(pendingHeroLoad.id);
    }

    pendingHeroLoad = null;
  };

  const cleanupHeroVideo = () => {
    cancelPendingHeroLoad();

    if (resumeHeroPlayback) {
      document.removeEventListener('visibilitychange', resumeHeroPlayback);
      window.removeEventListener('pageshow', resumeHeroPlayback);
      resumeHeroPlayback = null;
    }

    document.querySelectorAll('[data-hero-video]').forEach((element) => {
      if (!(element instanceof HTMLVideoElement)) return;
      element.pause();
      element.classList.remove('is-ready');
    });
  };

  const isAppleTouchDevice = () => {
    const platform = navigator.platform;
    const userAgent = navigator.userAgent;
    return /iPhone|iPad|iPod/.test(userAgent) || (platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  };

  const initHeroVideo = () => {
    const video = document.querySelector('[data-hero-video]');
    if (!(video instanceof HTMLVideoElement) || video.dataset.initialized) return;

    const connection = (navigator as Navigator & { connection?: NetworkInformation }).connection;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion || connection?.saveData) return;

    video.dataset.initialized = 'true';
    video.muted = true;
    video.defaultMuted = true;
    video.playsInline = true;
    video.setAttribute('playsinline', '');
    video.setAttribute('webkit-playsinline', '');
    video.loop = true;

    const playHero = async () => {
      if (!video.isConnected || !video.paused) return;
      try {
        video.muted = true;
        await video.play();
      } catch {
        // Autoplay can fail before the file is ready. canplay retries below.
      }
    };

    const loadVideo = async () => {
      pendingHeroLoad = null;
      if (!video.isConnected) return;

      const skipWebm = isAppleTouchDevice();
      video.querySelectorAll('source[data-src]').forEach((source) => {
        if (!(source instanceof HTMLSourceElement) || !source.dataset.src) return;
        if (skipWebm && source.type.includes('webm')) {
          source.remove();
          return;
        }
        source.src = source.dataset.src;
      });

      video.addEventListener('playing', () => {
        if (video.isConnected) video.classList.add('is-ready');
      });
      video.addEventListener('canplay', () => {
        void playHero();
      });
      video.addEventListener('ended', () => {
        video.currentTime = 0;
        void playHero();
      });

      video.load();
      await playHero();
    };

    const scheduleLoad = () => {
      if (isAppleTouchDevice()) {
        const id = window.setTimeout(() => void loadVideo(), 0);
        pendingHeroLoad = { id, kind: 'timeout' };
        return;
      }

      if ('requestIdleCallback' in window) {
        const id = window.requestIdleCallback(() => void loadVideo(), { timeout: 1500 });
        pendingHeroLoad = { id, kind: 'idle' };
      } else {
        const id = window.setTimeout(() => void loadVideo(), 500);
        pendingHeroLoad = { id, kind: 'timeout' };
      }
    };

    resumeHeroPlayback = () => {
      if (document.hidden || video.paused === false) return;
      void playHero();
    };
    document.addEventListener('visibilitychange', resumeHeroPlayback);
    window.addEventListener('pageshow', resumeHeroPlayback);

    scheduleLoad();
  };

  document.addEventListener('astro:page-load', initHeroVideo);
  document.addEventListener('astro:before-swap', cleanupHeroVideo);
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: calc(var(--header-h) + 2.5rem) 0 4.5rem;
    overflow: hidden;
  }

  .hero--gift {
    min-height: min(88svh, 44rem);
    padding-top: calc(var(--header-h) + 4rem);
    background:
      radial-gradient(circle at 50% 20%, rgba(156, 143, 124, 0.12), transparent 50%),
      linear-gradient(180deg, rgba(24, 35, 24, 0.55), transparent 70%);
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__image,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
    filter: brightness(0.55) saturate(0.85);
  }

  .hero__video {
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
  }

  .hero__video.is-ready {
    opacity: 1;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(24, 35, 24, 0.72),
        rgba(24, 35, 24, 0.55) 45%,
        rgba(24, 35, 24, 0.88)
      ),
      radial-gradient(ellipse at 50% 40%, transparent 20%, rgba(24, 35, 24, 0.45) 100%);
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 52rem;
    animation: heroIn 0.9s var(--ease-out) both;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 1.05rem;
    border-radius: var(--radius-pill);
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-accent-soft);
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .hero h1 {
    font-size: clamp(2.4rem, 7vw, 4.75rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .hero__lead {
    margin-top: 1.15rem;
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--color-text-muted);
    max-width: 40rem;
    margin-inline: auto;
    line-height: 1.85;
  }

  .hero__actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
  }

  @media (max-width: 479px) {
    .hero {
      min-height: 100svh;
      padding-top: calc(var(--header-h) + 1.5rem);
      padding-bottom: 3rem;
    }

    .hero h1 {
      font-size: clamp(1.95rem, 9vw, 2.5rem);
    }

    .hero__actions {
      flex-direction: column;
      align-items: center;
      width: 100%;
    }
  }

  @keyframes heroIn {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
  }
</style>
