---
import { site } from '../data/site';

interface Props {
  class?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { class: className = '', size = 'md' } = Astro.props;

const heights = {
  sm: '2.75rem',
  md: '3.5rem',
  lg: '7.5rem',
} as const;
---

<span class:list={['logo', `logo--${size}`, className]}>
  <img
    class="logo__image"
    src="/images/logo-full.png"
    alt={`${site.nameAr} — ${site.nameEn}`}
    width="849"
    height="853"
    style={`height: ${heights[size]}; width: auto;`}
  />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }

  .logo__image {
    display: block;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  @media (min-width: 768px) {
    .logo--md .logo__image {
      height: 4.15rem !important;
    }
  }
</style>
