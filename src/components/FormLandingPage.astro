---
import Logo from './Logo.astro';
import FormBranches from './FormBranches.astro';
import FormActions from './FormActions.astro';
import ContactForm from './ContactForm.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { formCopy, type FormLocale } from '../lib/form-copy';

interface Props {
  locale?: FormLocale;
}

const { locale = 'ar' } = Astro.props;
const copy = formCopy[locale];
const brandHref = '/';
---

<section class="form-landing">
  <div class="container form-landing__inner">
    <div class="form-landing__brand">
      <a href={brandHref} aria-label={copy.homeAria}>
        <Logo size="sm" />
      </a>
      <LanguageSwitcher locale={locale} />
    </div>

    <nav class="form-landing__crumb" aria-label={copy.crumbsAria} data-form-landing-crumb>
      <ol>
        <li>
          <a href={brandHref}>{copy.home}</a>
        </li>
        <li>
          <span aria-hidden="true">/</span>
          <h1>{copy.contact}</h1>
        </li>
      </ol>
    </nav>

    <div class="form-landing__grid">
      <div class="form-landing__info">
        <FormBranches locale={locale} />
        <FormActions locale={locale} />
      </div>
      <div class="form-landing__form">
        <ContactForm locale={locale} />
      </div>
    </div>

    <p class="form-landing__full">
      <a href={brandHref}>{copy.fullSite}</a>
    </p>
  </div>
</section>

<style>
  .form-landing {
    min-height: 100dvh;
    background: var(--color-bg);
  }

  .form-landing__inner {
    display: flex;
    min-height: 100dvh;
    min-width: 0;
    flex-direction: column;
    padding-block: 2rem;
  }

  .form-landing__brand {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .form-landing__crumb {
    margin-top: 1.5rem;
  }

  .form-landing__crumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .form-landing__crumb li {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 0.5rem;
  }

  .form-landing__crumb a:hover {
    color: var(--color-gold);
  }

  .form-landing__crumb h1 {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .form-landing__crumb span {
    color: var(--color-gold);
    opacity: 0.5;
  }

  .form-landing__grid {
    display: grid;
    flex: 1;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
    width: 100%;
    min-width: 0;
    margin-top: 1.5rem;
  }

  .form-landing__info {
    display: grid;
    min-width: 0;
    gap: 0;
  }

  .form-landing__form {
    order: -1;
    min-width: 0;
  }

  .form-landing__full {
    margin-top: 2rem;
    text-align: center;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .form-landing__full a {
    color: var(--color-gold);
  }

  .form-landing__full a:hover {
    color: var(--color-gold-light);
  }

  @media (min-width: 1024px) {
    .form-landing__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
    }

    .form-landing__form {
      order: 0;
    }
  }
</style>
