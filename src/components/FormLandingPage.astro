---
import Logo from './Logo.astro';
import FormBranches from './FormBranches.astro';
import FormActions from './FormActions.astro';
import ContactForm from './ContactForm.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { formCopy, type FormLocale } from '../lib/form-copy';

interface Props {
  locale?: FormLocale;
}

const { locale = 'ar' } = Astro.props;
const copy = formCopy[locale];
---

<section class="form-landing">
  <div class="container form-landing__inner">
    <div class="form-landing__brand">
      <Logo size="sm" />
      <LanguageSwitcher locale={locale} />
    </div>

    <h1 class="form-landing__title">{copy.contact}</h1>

    <div class="form-landing__grid">
      <div class="form-landing__info">
        <FormBranches locale={locale} />
        <FormActions locale={locale} />
      </div>
      <div class="form-landing__form">
        <ContactForm locale={locale} />
      </div>
    </div>
  </div>
</section>

<style>
  .form-landing {
    min-height: 100dvh;
    background: var(--color-bg);
  }

  .form-landing__inner {
    display: flex;
    min-height: 100dvh;
    min-width: 0;
    flex-direction: column;
    padding-block: 2rem;
  }

  .form-landing__brand {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .form-landing__title {
    margin-top: 1.5rem;
    min-width: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .form-landing__grid {
    display: grid;
    flex: 1;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
    width: 100%;
    min-width: 0;
    margin-top: 1.5rem;
  }

  .form-landing__info {
    display: grid;
    min-width: 0;
    gap: 0;
  }

  .form-landing__form {
    display: grid;
    order: -1;
    place-items: center;
    min-width: 0;
  }

  @media (min-width: 900px) {
    .form-landing__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
    }

    :global([dir='rtl']) .form-landing__form {
      order: 0;
    }
  }
</style>
