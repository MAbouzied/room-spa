---
import Logo from './Logo.astro';
import FormBranches from './FormBranches.astro';
import FormActions from './FormActions.astro';
import ContactForm from './ContactForm.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { formCopy, type FormLocale } from '../lib/form-copy';

interface Props {
  locale?: FormLocale;
}

const { locale = 'ar' } = Astro.props;
const copy = formCopy[locale];
---

<section class="form-landing">
  <div class="form-landing__inner">
    <div class="form-landing__brand">
      <Logo size="sm" />
      <LanguageSwitcher locale={locale} />
    </div>

    <h1 class="form-landing__title">{copy.contact}</h1>

    <div class="form-landing__stack">
      <FormBranches locale={locale} />
      <div class="form-landing__ctas">
        <ContactForm locale={locale} />
        <FormActions locale={locale} />
      </div>
    </div>
  </div>
</section>

<style>
  .form-landing {
    min-height: 100dvh;
    background: var(--color-bg);
  }

  .form-landing__inner {
    display: flex;
    width: min(100% - 1.5rem, 32rem);
    max-width: 32rem;
    min-height: 100dvh;
    min-width: 0;
    margin-inline: auto;
    flex-direction: column;
    padding-block: 2rem;
  }

  @media (min-width: 768px) {
    .form-landing__inner {
      width: min(100% - 2.5rem, 32rem);
    }
  }

  .form-landing__brand {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .form-landing__title {
    margin-top: 1.5rem;
    min-width: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .form-landing__stack {
    display: grid;
    width: 100%;
    min-width: 0;
    margin-top: 1.5rem;
    gap: 0;
  }

  .form-landing__ctas {
    display: grid;
    width: 100%;
    min-width: 0;
    margin-top: 2rem;
    gap: 0.75rem;
  }
</style>
