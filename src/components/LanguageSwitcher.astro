---
import { formCopy, switchFormPath, type FormLocale } from '../lib/form-copy';

interface Props {
  locale?: FormLocale;
}

const { locale = 'ar' } = Astro.props;
const copy = formCopy[locale];
const href = `${switchFormPath(Astro.url.pathname)}${Astro.url.search}`;
const altLocale = locale === 'en' ? 'ar' : 'en';
---

<a
  class="language-switcher"
  href={href}
  hreflang={altLocale}
  aria-label={copy.langSwitchAria}
  data-language-switcher
>
  {copy.langSwitchLabel}
</a>

<style>
  .language-switcher {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-gold);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .language-switcher:hover,
  .language-switcher:focus-visible {
    border-color: var(--color-gold);
    color: var(--color-gold-light);
  }
</style>
