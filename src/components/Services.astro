---
import { serviceCategories } from '../data/services';
import SectionHeading from './SectionHeading.astro';
import ServiceCategoryCard from './ServiceCategoryCard.astro';

const categoryIcons: Record<string, string> = {
  massage: 'mdi:hand-heart',
  hammam: 'mdi:shower',
  pedicure: 'ph:hand',
};

const massage = serviceCategories.find((category) => category.id === 'massage');
const stacked = serviceCategories.filter((category) => category.id === 'hammam' || category.id === 'pedicure');
---

<section class="section services" id="services">
  <div class="container">
    <SectionHeading
      eyebrow="خدماتنا"
      title="نقدم مجموعة متكاملة من الخدمات المصممة بعناية"
      highlight="متكاملة"
      breakBefore="من الخدمات"
      lead="لتمنحك راحة عميقة تنعكس على صحتك الجسدية والنفسية"
    />
    <div class="services__list">
      {
        massage && (
          <ServiceCategoryCard
            category={massage}
            icon={categoryIcons[massage.id] ?? 'mdi:spa-outline'}
          />
        )
      }
      <div class="services__aside">
        {
          stacked.map((category) => (
            <ServiceCategoryCard
              category={category}
              icon={categoryIcons[category.id] ?? 'mdi:spa-outline'}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .services__list {
    display: grid;
    gap: 1.25rem;
    align-items: start;
  }

  .services__aside {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    height: fit-content;
  }

  @media (min-width: 900px) {
    .services__list {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>
