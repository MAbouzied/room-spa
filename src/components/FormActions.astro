---
import { Icon } from 'astro-icon/components';
import Button from './Button.astro';
import { site } from '../data/site';
import { buildOffersWhatsAppUrl } from '../lib/contact-form';
import { formCopy, type FormLocale } from '../lib/form-copy';

interface Props {
  locale?: FormLocale;
}

const { locale = 'ar' } = Astro.props;
const copy = formCopy[locale];
---

<nav class="form-actions" aria-label={copy.actionsAria} data-form-actions>
  <Button href={`tel:${site.phoneTel}`} variant="outline" shape="xl" full>
    <Icon name="mdi:phone" class="icon icon--md" aria-hidden="true" />
    {copy.callAction}
  </Button>
  <Button href={site.google.mapsUrl} variant="outline" shape="xl" external full>
    <Icon name="mdi:map-marker-outline" class="icon icon--md" aria-hidden="true" />
    {copy.locationAction}
  </Button>
  <Button href={buildOffersWhatsAppUrl(locale)} variant="accent" shape="xl" external full>
    <Icon name="mdi:whatsapp" class="icon icon--md" aria-hidden="true" />
    {copy.offersAction}
  </Button>
</nav>

<style>
  .form-actions {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
  }
</style>
