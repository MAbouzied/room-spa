---
export interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
  focalPoint?: { x: number; y: number };
}

const {
  src,
  alt,
  width,
  height,
  caption,
  loading = 'lazy',
  class: className = '',
  focalPoint,
} = Astro.props;

const objectPosition =
  focalPoint &&
  Number.isFinite(focalPoint.x) &&
  Number.isFinite(focalPoint.y)
    ? `${Math.min(100, Math.max(0, focalPoint.x * 100)).toFixed(2)}% ${Math.min(
        100,
        Math.max(0, focalPoint.y * 100),
      ).toFixed(2)}%`
    : undefined;
---

<figure class:list={['blog-image', className]}>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    style={objectPosition ? `--blog-object-position: ${objectPosition}` : undefined}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
