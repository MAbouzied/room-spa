---
import BlogImage from './BlogImage.astro';
import BlogMeta from './BlogMeta.astro';
import { readingTimeForPost } from '../lib/reading-time';
import type { BlogArticleLabels, BlogListingLabels, BlogPost } from '../model/blog-types';
import {
  DEFAULT_BLOG_ARTICLE_LABELS,
  DEFAULT_BLOG_LISTING_LABELS,
} from '../model/blog-types';

export interface Props {
  post: BlogPost;
  labels?: BlogListingLabels;
  metaLabels?: BlogArticleLabels;
}

const {
  post,
  labels = DEFAULT_BLOG_LISTING_LABELS,
  metaLabels = DEFAULT_BLOG_ARTICLE_LABELS,
} = Astro.props;

const href = `/blogs/${post.slug}/`;
const readingTimeMinutes = readingTimeForPost(post);
---

<article class="blog-featured">
  <div class="blog-featured__media">
    <BlogImage
      src={post.cover.src}
      alt={post.cover.alt}
      width={post.cover.width}
      height={post.cover.height}
      caption={post.cover.caption}
      focalPoint={post.cover.focalPoint}
      loading="eager"
    />
  </div>
  <div class="blog-featured__content">
    <p class="blog-featured__eyebrow">{labels.featuredEyebrow}</p>
    <BlogMeta post={post} readingTimeMinutes={readingTimeMinutes} labels={metaLabels} />
    <h2 class="blog-featured__title">
      <a href={href}>{post.title}</a>
    </h2>
    <p class="blog-featured__excerpt">{post.excerpt}</p>
    <a class="blog-cta" href={href}>{labels.readArticle}</a>
  </div>
</article>
