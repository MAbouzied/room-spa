---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormLandingPage from '../../components/FormLandingPage.astro';
import { breadcrumbSchema, buildGraph, webPageSchema } from '../../lib/schema';
import { formCopy } from '../../lib/form-copy';

const locale = 'en' as const;
const copy = formCopy[locale];
const path = '/en/form';
---

<BaseLayout
  title={copy.pageTitle}
  description={copy.pageDescription}
  path={path}
  locale={locale}
  noindex
  robotsFollow
  hideChrome
  schemas={[
    buildGraph([
      webPageSchema({
        title: copy.pageTitle,
        description: copy.pageDescription,
        path,
        type: 'ContactPage',
      }),
      breadcrumbSchema([
        { name: copy.home, path: '/' },
        { name: copy.contact, path },
      ]),
    ]),
  ]}
>
  <FormLandingPage locale={locale} />
</BaseLayout>
