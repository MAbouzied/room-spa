---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="الصفحة غير موجودة | روم سبا"
  description="الصفحة التي تبحث عنها غير موجودة."
  path="/404"
  navVariant="home"
>
  <section class="section not-found">
    <div class="container not-found__inner">
      <p class="not-found__code">404</p>
      <h1>الصفحة غير موجودة</h1>
      <p>عذرًا، لم نتمكن من العثور على الصفحة المطلوبة.</p>
      <div class="not-found__actions">
        <Button href="/" variant="accent" shape="xl">العودة للرئيسية</Button>
        <Button href="/gift" variant="outline" shape="xl">صفحة الإهداءات</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found__inner {
    text-align: center;
    max-width: 36rem;
    padding-block: clamp(4rem, 12vw, 8rem);
  }

  .not-found__code {
    font-size: clamp(3rem, 10vw, 5rem);
    font-weight: 800;
    color: var(--color-accent-soft);
    line-height: 1;
    margin-bottom: 0.75rem;
  }

  .not-found h1 {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    margin-bottom: 0.75rem;
  }

  .not-found p:not(.not-found__code) {
    color: var(--color-text-muted);
  }

  .not-found__actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
</style>
